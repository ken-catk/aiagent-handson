# ==============================================================
# 会食ムキムキ君 AI Agent × グルメ検索MCP — 環境変数テンプレ
# このファイルはGit管理対象。実際の値は .env に書き、.env はコミットしない。
# ==============================================================

# --- OpenAI ---
# Responses APIを使うため、openai SDK v6系を想定
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
# モデル名の候補: gpt-4.1-mini / gpt-4.1 / gpt-5.2 など
OPENAI_MODEL=gpt-4.1-mini

# --- グルメ検索API ---
# API URL と API キーは Slack で配布される登録情報を参照してセット
GOURMET_API_URL=
GOURMET_API_KEY=

# --- MCP Auth ---
# 32文字以上のランダム文字列を推奨
# 生成例: openssl rand -hex 24
MCP_AUTH_TOKEN=replace-with-random-32-plus-chars
AGENT_MCP_TOKEN=replace-with-same-as-MCP_AUTH_TOKEN

# --- Logging ---
LOG_DIR=./logs
